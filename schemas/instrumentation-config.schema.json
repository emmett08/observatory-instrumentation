{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emmett08/observatory-instrumentation/schemas/instrumentation-config.schema.json",
  "title": "Observatory instrumentation registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_id", "repositories", "tasks", "discovery"],
  "properties": {
    "schema": {"const": "observatory.instrumentation/1"},
    "protocol_id": {"$ref": "#/$defs/identifier"},
    "repositories": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "workflow_paths"],
        "properties": {
          "repository": {"$ref": "#/$defs/repository"},
          "workflow_paths": {
            "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true,
            "items": {"type": "string", "maxLength": 256, "pattern": "^\\.github/workflows/[A-Za-z0-9][A-Za-z0-9_.-]*\\.ya?ml$"}
          }
        }
      }
    },
    "tasks": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "repository", "issue_number"],
        "properties": {
          "task_id": {
            "allOf": [
              {"$ref": "#/$defs/identifier"},
              {"not": {"enum": ["total", "unattributed", "unknown"]}},
              {"not": {"pattern": "^github-issue-"}}
            ]
          },
          "repository": {"$ref": "#/$defs/repository"},
          "issue_number": {"type": "integer", "minimum": 1, "maximum": 2147483647}
        }
      }
    },
    "discovery": {
      "type": "object", "additionalProperties": false,
      "required": ["lookback_days", "max_runs_per_repository"],
      "properties": {
        "lookback_days": {"type": "integer", "minimum": 1, "maximum": 90},
        "max_runs_per_repository": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"}
  },
  "$comment": "The Go validator additionally rejects duplicate JSON keys, case-insensitive repository duplicates, duplicate task IDs/issue bindings, aliases outside the repository allowlist, and oversized documents."
}
